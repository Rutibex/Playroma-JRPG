    {
      "pluginId": "YEP_RegionEvents",
      "syntax": "<Region x Event: y>",
      "featureId": "region-events.region-common-event",
      "displayName": "Region Common Event",
      "summary": "Runs a selected common event when the player enters a selected region on this map.",
      "surface": "mapNote",
      "documentKinds": [
        "map"
      ],
      "syntaxKind": "keyValue",
      "canonicalTemplate": "<Region {regionId} Event: {commonEventId}>",
      "openingRegularExpression": "^<\\s*Region\\s+(?<regionId>\\d+)\\s+Event\\s*:\\s*(?<commonEventId>\\d+)\\s*>$",
      "multiplicity": "repeatableByKey",
      "specializedEditorId": "yep.region-rules",
      "arguments": [
        {
          "name": "regionId",
          "displayName": "Region",
          "kind": "regionId",
          "isRequired": true,
          "minimum": 1,
          "maximum": 255,
          "referenceKind": "region"
        },
        {
          "name": "commonEventId",
          "displayName": "Common Event",
          "kind": "commonEventId",
          "isRequired": true,
          "minimum": 1,
          "referenceKind": "commonEvent"
        }
      ],
      "matchPriority": 500
    },
    {
