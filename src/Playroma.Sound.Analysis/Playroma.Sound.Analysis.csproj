<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Platform-neutral real-time and offline waveform, spectrum, spectrogram, loudness, phase, clipping, and performance analysis for Playroma Sound.</Description>
    <PackageId>Playroma.Sound.Analysis</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Playroma.Sound.Core\Playroma.Sound.Core.csproj" />
    <ProjectReference Include="..\Playroma.Sound.Streaming\Playroma.Sound.Streaming.csproj" />
  </ItemGroup>
</Project>
