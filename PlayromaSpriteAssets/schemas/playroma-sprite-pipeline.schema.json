{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playroma.dev/schemas/playroma-sprite-pipeline.schema.json",
  "title": "Playroma Sprite Automation Pipeline",
  "type": "object",
  "required": ["schema", "name", "steps"],
  "properties": {
    "schema": { "const": "playroma-sprite-pipeline/1" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "requiredCapabilities": { "type": ["string", "integer"] },
    "continueOnError": { "type": "boolean" },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "enabled": { "type": "boolean" },
        "continueOnError": { "type": "boolean" },
        "arguments": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  }
}
