{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playroma.dev/schemas/playroma-sprite-extension.schema.json",
  "title": "Playroma Sprite Extension Manifest",
  "type": "object",
  "required": ["schema", "id", "name", "version", "entryAssembly", "entryType"],
  "properties": {
    "schema": { "const": "playroma-sprite-extension/1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "author": { "type": ["string", "null"] },
    "entryAssembly": { "type": "string", "minLength": 1 },
    "entryType": { "type": "string", "minLength": 1 },
    "requestedCapabilities": { "type": ["string", "integer"] },
    "commands": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "formatProviders": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false
}
